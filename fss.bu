variant: fcos
version: 1.7.0
systemd:
  units:
    - name: getty@tty1.service
      dropins:
      - name: autologin-core.conf
        contents: |
          [Service]
          # Override Execstart in main unit
          ExecStart=
          # Add new Execstart with `-` prefix to ignore failure
          ExecStart=-/usr/sbin/agetty --autologin core --noclear %I $TERM
storage:
  disks:
    - device: /dev/vda
      wipe_table: false
      partitions:
        - label: var
  filesystems:
    - device: /dev/disk/by-partlabel/var
      label: var
      format: ext4
      wipe_filesystem: false
      path: /var
      with_mount_unit: true
  directories:
  #create directory for continuwuity database
  - path: /var/lib/continuwuity
    overwrite: false
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: |
          fss
    - path: /etc/profile.d/systemd-pager.sh
      mode: 0644
      contents:
        inline: |
          # Tell systemd to not use a pager when printing information
          export SYSTEMD_PAGER=cat
    - path: /etc/containers/systemd/caddy.container
      contents:
        local: quadlets/caddy.container
      overwrite: true
    - path: /etc/containers/systemd/continuwuity.container
      contents:
        local: quadlets/continuwuity.container
      overwrite: true
    - path: /etc/containers/systemd/client.container
      contents:
        local: quadlets/client.container
      overwrite: true
    - path: /etc/caddy/Caddyfile
      contents:
        local: ./Caddyfile
    - path: /etc/client/config.json
      contents:
        local: ./config.json
    - path: /etc/continuwuity/config.toml
      contents:
        local: ./conduwuit-example.toml
